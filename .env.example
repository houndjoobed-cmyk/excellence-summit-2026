# Neon PostgreSQL Connection String (Pooled for runtime, Unpooled for Drizzle migrations)
# Get this from https://console.neon.tech or via `neon deploy`
DATABASE_URL="postgresql://USER:PASSWORD@ep-your-project-pooler.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-your-project.region.aws.neon.tech/neondb?sslmode=require"

# Neon Realtime (WebSocket live queries)
NEON_REALTIME_URL="wss://ep-your-project.rt.region.aws.neon.tech/"
NEON_REALTIME_SECRET="your-neon-realtime-secret"
NEXT_PUBLIC_NEON_REALTIME_URL="wss://ep-your-project.rt.region.aws.neon.tech/"

# Transactional Email Configuration (optional: supports Brevo without custom domain, or Resend with custom domain)
# Auto mode uses Brevo when BREVO_API_KEY + BREVO_SENDER_EMAIL are set, or Resend with custom RESEND_FROM_EMAIL.
# Optional override: EMAIL_PROVIDER="brevo" | "resend"
EMAIL_PROVIDER=""

# Option 1: Brevo API v3 (works without a custom domain after verifying a sender email in Brevo)
BREVO_API_KEY="xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
BREVO_SENDER_EMAIL="votre-email-verifie@gmail.com"
BREVO_SENDER_NAME="Excellence Summit 2026"

# Option 2: Resend (recommended once you own a verified custom domain)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="Excellence Summit <noreply@votre-domaine.com>"

# Public Site URL (used inside QR verification links, SEO metadata, and badge emails)
# Optional on Vercel: automatically falls back to https://$VERCEL_PROJECT_PRODUCTION_URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin Dashboard Authentication
# IMPORTANT: Set both to strong unique values before deploying to production!
# Generate a 64-char secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_PASSWORD="change-me-strong-password"
ADMIN_SESSION_SECRET="replace-with-at-least-32-random-characters-for-hmac-signing"

